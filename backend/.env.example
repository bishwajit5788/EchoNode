# EchoNode Backend & Extraction Worker Configuration
# Copy to .env and configure for your environment. Never commit real credentials!

# Server Configuration
PORT=8000
HOST=0.0.0.0
# Set DOWNLOADS_DIR to custom path if desired (defaults to backend/downloads or /tmp/downloads)
# DOWNLOADS_DIR=/data/echonode/downloads

# Worker Mode Configuration
# In Vercel serverless mode, point WORKER_URL to your persistent extraction worker instance
# WORKER_URL=https://echonode-worker.yourdomain.com

# YouTube Authentication & Anti-Bot Bypass (Worker Only)
# Pass cookies text directly via env var or specify a local gitignored file path
# YTDLP_COOKIES="# Netscape HTTP Cookie File\n# ..."
# YTDLP_COOKIES_PATH=/etc/echonode/cookies.txt

# Storage Configuration
# Options: "local" (default) or "s3"
STORAGE_BACKEND=local

# S3 / Cloudflare R2 / MinIO Configuration (Required if STORAGE_BACKEND=s3)
# S3_BUCKET_NAME=echonode-audio
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_REGION_NAME=auto
# STORAGE_PUBLIC_URL_PREFIX=https://cdn.echonode.internal/audio
